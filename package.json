{
  "name": "michibiki-suimon-navi",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "node scripts/dev-server.mjs",
    "build": "node scripts/build-static.mjs",
    "cf:dev": "npm run build && wrangler dev",
    "cf:deploy": "npm run build && wrangler deploy",
    "backend": "node scripts/run-backend.mjs",
    "backend:mock": "node scripts/run-backend.mjs --mode mock --allow-safe-commands",
    "backend:real": "node scripts/run-backend.mjs --mode real",
    "backend:setup": "node scripts/setup-backend.mjs",
    "dev": "node scripts/dev-all.mjs",
    "test": "node --test tests/unit/*.test.js",
    "test:backend": "node scripts/run-pytest.mjs",
    "test:browser": "playwright test",
    "test:all": "npm run test && npm run test:backend && npm run test:browser"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "wrangler": "^4.127.1"
  }
}
