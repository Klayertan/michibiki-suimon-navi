.vite/

# Local field captures
data/*.nmea
!data/samples/
!data/samples/*.nmea

# QZ1 water-level experiment captures.
#
# A GNSS recording is a precise, timestamped record of where the receiver --
# and therefore a person or a specific paddy -- actually was. Real runs are
# therefore ignored by default and committed only by deliberate `git add -f`
# on a file someone has looked at. The directory itself is kept so the
# analysis scripts have somewhere to write.
#
# The SYNTHETIC fixtures under tests/fixtures/qz1-water-level/ are exempt:
# they are generated by a noise model at a made-up coordinate, contain no
# measurement and no real location, and the tests need them.
experiments/qz1-water-level/data/*
!experiments/qz1-water-level/data/.gitkeep

# Local perception datasets / generated training data (back up separately)
datasets/
training/

# Python — MAVLink backend
# The virtual environment is repository-local by design (the backend must not
# depend on globally installed packages) but is never committed.
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Cloudflare Workers
#
# `dist/` (the deployable copy assembled by scripts/build-static.mjs) is
# already ignored above as a generic build output. `.wrangler/` is wrangler's
# local state: the workerd binary's scratch space, local KV/D1/R2 simulation
# and the dev cache. Both are regenerated by `npm run build` / `npm run cf:dev`
# and neither belongs in git.
.wrangler/
