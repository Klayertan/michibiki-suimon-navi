# Copy this file to `.env` (NEVER commit `.env` — it is already in
# .gitignore) and fill in real values. Every value below is a placeholder
# name, not a working secret.
#
# Used by both docker-compose.yml (the POSTGRES_* values) and the app
# itself directly (the SUISUI_CLOUD_* values — see app/config.py, which
# reads everything under the SUISUI_CLOUD_ prefix). In production these are
# not read from a file at all — they are set as real environment variables
# on the Sakura Cloud VM (see docs/SAKURA_CLOUD_DEPLOYMENT.md) or injected
# by GitHub Actions from repository secrets at deploy time.

# --- PostgreSQL (docker-compose's db service; also used to build
#     SUISUI_CLOUD_DATABASE_URL for the api service automatically) --------
POSTGRES_USER=suisuinavi
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=suisuinavi
# Uncomment only if 5432/8000 are already taken on your machine.
# POSTGRES_HOST_PORT=5432
# API_HOST_PORT=8000

# --- Required application secrets -----------------------------------------
# A long random value (e.g. `openssl rand -base64 48`). The app refuses to
# start in production without this set. See app/config.py's own comment on
# what this key does and does not protect (it is not a JWT signing key —
# sessions are opaque server-side tokens, see app/security.py).
SUISUI_CLOUD_SESSION_SECRET=change-me-to-a-long-random-value

# --- Environment -----------------------------------------------------------
# "development" (default if unset) or "production". Production additionally
# requires SUISUI_CLOUD_SESSION_SECRET (above) and forces Secure cookies.
SUISUI_CLOUD_ENVIRONMENT=development

# --- Database ---------------------------------------------------------------
# Set directly (not via docker-compose's variable substitution) only when
# running the app OUTSIDE docker-compose, e.g. against a real Sakura Cloud
# managed/self-hosted PostgreSQL instance. Async driver (+asyncpg) — see
# app/database.py and migrations/env.py for why migrations use a derived
# +psycopg2 URL instead.
# SUISUI_CLOUD_DATABASE_URL=postgresql+asyncpg://suisuinavi:change-me@127.0.0.1:5432/suisuinavi

# --- Session cookie ----------------------------------------------------------
# Leave EMPTY for local/dev/Docker Compose (host-only cookie — works against
# any localhost frontend). Set to ".suisuinavi.sakura.ne.jp" only in the
# real production deployment, where the frontend (suisuinavi.sakura.ne.jp)
# and the API (api.suisuinavi.sakura.ne.jp) are same-site siblings that need
# to share the cookie. See app/config.py's comment and
# docs/AUTH_ARCHITECTURE.md — "Cookie domain and SameSite" before changing
# this.
SUISUI_CLOUD_SESSION_COOKIE_DOMAIN=

# --- CORS --------------------------------------------------------------------
# Comma-separated exact origins (scheme + host + port), never a wildcard.
# The production value should be:
#   https://suisuinavi.sakura.ne.jp
# Local/dev typically needs the Playwright/dev-server origin instead:
SUISUI_CLOUD_ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173

# --- Email verification (Phase 6) --------------------------------------------
# Stays "false" until SMTP below is actually configured AND you have
# deliberately decided to require verified email before login. Never set
# this true without SMTP configured — accounts would be created but nobody
# could ever verify them. See docs/AUTH_ARCHITECTURE.md — "Email
# verification and password reset".
SUISUI_CLOUD_REQUIRE_EMAIL_VERIFICATION=false

# --- SMTP (optional; only needed once SUISUI_CLOUD_REQUIRE_EMAIL_VERIFICATION
#     is true, or password-reset email is wired up) --------------------------
# SUISUI_CLOUD_SMTP_HOST=
# SUISUI_CLOUD_SMTP_PORT=587
# SUISUI_CLOUD_SMTP_USERNAME=
# SUISUI_CLOUD_SMTP_PASSWORD=
# SUISUI_CLOUD_SMTP_SENDER=no-reply@suisuinavi.sakura.ne.jp
# SUISUI_CLOUD_SMTP_USE_TLS=true

# --- Rate limiting (optional overrides; sensible defaults already set in
#     app/config.py) -----------------------------------------------------
# SUISUI_CLOUD_LOGIN_RATE_LIMIT_ATTEMPTS=10
# SUISUI_CLOUD_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
# SUISUI_CLOUD_REGISTER_RATE_LIMIT_ATTEMPTS=5
# SUISUI_CLOUD_REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600

# --- Registration cap (presentation / limited-access mode) -------------------
# See docs/AUTH_ARCHITECTURE.md — "Registration cap" for the full design
# (atomic enforcement via a PostgreSQL advisory lock — no schema change) and
# docs/SAKURA_CLOUD_DEPLOYMENT.md — "Presentation workflow" for the exact
# before/after-presentation commands.
#
# PRODUCTION MUST SET SUISUI_CLOUD_MAX_REGISTERED_USERS EXPLICITLY — the app
# refuses to start in production if it is unset (fails closed rather than
# silently allowing unlimited registration; see app/main.py). Existing users
# can always still log in regardless of either setting below — only NEW
# registration is affected.
#
# Before a presentation/demo with judges (open, capped at 10 total accounts,
# including your own):
SUISUI_CLOUD_REGISTRATION_OPEN=true
SUISUI_CLOUD_MAX_REGISTERED_USERS=10
#
# After the presentation, to close registration without touching the cap
# (existing accounts keep working, no new ones can be created):
# SUISUI_CLOUD_REGISTRATION_OPEN=false
#
# Local dev / this test suite: leave both unset. registration_open defaults
# to true and max_registered_users defaults to unset (no cap) so tests and a
# local `uvicorn` run can register as many accounts as needed — the
# production boot-refusal above only fires when SUISUI_CLOUD_ENVIRONMENT=production.
